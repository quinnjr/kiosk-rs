---
import type { GetStaticPaths } from 'astro';
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Prose from '../components/Prose.astro';
import { nav, HOME_ID, sourceUrl } from '../nav';

// Routes come from `nav`, not from the collection, so the URL is the curated
// slug rather than the source path. The home page is owned by `index.astro`.
export const getStaticPaths: GetStaticPaths = async () =>
  nav
    .filter((page) => page.id !== HOME_ID)
    .map((page) => ({ params: { slug: page.slug }, props: { page } }));

const { page } = Astro.props;
const entry = await getEntry('docs', page.id);
if (!entry) {
  throw new Error(
    `No content entry for "${page.id}" — nav.ts and content.config.ts disagree.`,
  );
}
const { Content, headings } = await render(entry);

// h2 only: these documents nest to h4 and a full tree would be longer than
// some of the sections it indexes.
const toc = headings.filter((heading) => heading.depth === 2);
---

<Base title={`${page.label} — kiosk-rs`} description={page.blurb} current={page.id}>
  <div class="xl:flex xl:gap-10">
    <div class="min-w-0 flex-1">
      <Prose editUrl={sourceUrl(page.id)}>
        <Content />
      </Prose>
    </div>

    {
      toc.length > 1 && (
        <aside class="mt-10 shrink-0 border-t border-slate-200 pt-6 xl:mt-0 xl:w-56 xl:border-t-0 xl:pt-0 dark:border-slate-800">
          <nav aria-label="On this page" class="xl:sticky xl:top-24">
            <p class="text-xs font-semibold tracking-wider text-slate-500 uppercase">
              On this page
            </p>
            <ul class="mt-3 space-y-2">
              {toc.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class="block text-sm text-slate-600 transition hover:text-accent-700 dark:text-slate-400 dark:hover:text-accent-400"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>
</Base>
