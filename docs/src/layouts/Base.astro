---
import '../styles/global.css';
import { nav } from '../nav';

interface Props {
  title: string;
  description?: string;
  /** Collection id of the current page, so the sidebar can mark it. */
  current?: string;
}

const { title, description, current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const desc =
  description ??
  'A minimal Wayland kiosk compositor in Rust: run one application fullscreen on one output.';

const href = (slug: string) => (slug === '' ? `${base}/` : `${base}/${slug}/`);
---

<html lang="en" class="scheme-light dark:scheme-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    {/* Set the theme before first paint so a dark-mode reader never sees a
        white flash. Inline and synchronous is the point. */}
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const dark =
          stored === 'dark' ||
          (!stored && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>

  <body
    class="min-h-screen bg-white font-sans text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-300"
  >
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-accent-500 focus:px-3 focus:py-2 focus:text-sm focus:font-medium focus:text-slate-950"
      >Skip to content</a
    >

    <header
      class="sticky top-0 z-40 border-b border-slate-200 bg-white/85 backdrop-blur dark:border-slate-800 dark:bg-slate-950/85"
    >
      <div
        class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4 sm:px-6 lg:px-8"
      >
        <a
          href={`${base}/`}
          class="flex items-center gap-2.5 font-mono text-sm font-semibold tracking-tight text-slate-900 dark:text-white"
        >
          <span
            class="grid size-7 place-items-center rounded bg-slate-900 font-bold text-accent-400 dark:bg-slate-800"
            aria-hidden="true">▌</span
          >
          kiosk-rs
        </a>

        <nav class="ml-auto flex items-center gap-1 sm:gap-2">
          <a
            href="https://github.com/quinnjr/kiosk-rs"
            class="rounded-md px-2.5 py-1.5 text-sm text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white"
            >GitHub</a
          >
          <button
            type="button"
            id="theme-toggle"
            aria-label="Toggle dark mode"
            class="grid size-9 place-items-center rounded-md text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white"
          >
            <svg
              class="size-4 dark:hidden"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              viewBox="0 0 24 24"
              aria-hidden="true"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21.75 15.5A9.75 9.75 0 1 1 8.5 2.25a7.75 7.75 0 0 0 13.25 13.25Z"
              /></svg
            >
            <svg
              class="hidden size-4 dark:block"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              viewBox="0 0 24 24"
              aria-hidden="true"
              ><circle cx="12" cy="12" r="4.25" /><path
                stroke-linecap="round"
                d="M12 2.75v2M12 19.25v2M2.75 12h2M19.25 12h2M5.5 5.5l1.4 1.4M17.1 17.1l1.4 1.4M18.5 5.5l-1.4 1.4M6.9 17.1L5.5 18.5"
              /></svg
            >
          </button>
        </nav>
      </div>
    </header>

    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="lg:flex lg:gap-10">
        <!-- Three pages, so a collapsible tree would be overkill; a flat list
             with blurbs is more useful than a bare set of links. -->
        <aside class="lg:w-64 lg:shrink-0 lg:pt-10">
          <nav aria-label="Documentation" class="lg:sticky lg:top-24">
            <p
              class="pt-6 pb-2 text-xs font-semibold tracking-wider text-slate-500 uppercase lg:pt-0 dark:text-slate-500"
            >
              Documentation
            </p>
            <ul class="space-y-0.5 border-l border-slate-200 dark:border-slate-800">
              {
                nav.map((entry) => {
                  const active = entry.id === current;
                  return (
                    <li>
                      <a
                        href={href(entry.slug)}
                        aria-current={active ? 'page' : undefined}
                        class:list={[
                          '-ml-px block border-l py-1.5 pl-4 text-sm transition',
                          active
                            ? 'border-accent-500 font-medium text-accent-700 dark:text-accent-400'
                            : 'border-transparent text-slate-600 hover:border-slate-400 hover:text-slate-900 dark:text-slate-400 dark:hover:border-slate-600 dark:hover:text-white',
                        ]}
                      >
                        {entry.label}
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </nav>
        </aside>

        <main id="content" class="min-w-0 flex-1 py-10">
          <slot />
        </main>
      </div>
    </div>

    <footer
      class="mt-16 border-t border-slate-200 py-8 dark:border-slate-800"
    >
      <div
        class="mx-auto flex max-w-6xl flex-col gap-2 px-4 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8"
      >
        <p>MIT licensed. Built with Astro and Tailwind.</p>
        <p class="font-mono text-xs">
          Docs are rendered from the repository's own Markdown — no copies.
        </p>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      });
    </script>
  </body>
</html>
